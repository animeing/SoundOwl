{
  "name": "frontend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "eslint-fix": "npx eslint --fix \"src/**/*.{js,vue}\"",
    "postinstall": "node scripts/sync-fontisto.js",
    "sync:fontisto": "node scripts/sync-fontisto.js",
    "update:fontisto": "npm update fontisto && npm run sync:fontisto",
    "build": "npx webpack --config webpack.config.js",
    "start": "node server.js",
    "test:layout": "playwright test --config playwright.config.mjs",
    "test:layout:ci": "node tests/scripts/run-layout-regression.mjs --artifact-dir test-results/layout-regression",
    "test:layout:update-baseline": "node tests/scripts/update-layout-baselines.mjs",
    "test:layout:local": "node tests/scripts/run-layout-regression.mjs",
    "test:layout:quick": "node tests/scripts/run-layout-regression.mjs --route home --viewport 320x667"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg/core": "^0.12.4",
    "@ffmpeg/ffmpeg": "^0.12.7",
    "@ffmpeg/util": "^0.12.1",
    "axios": "^1.6.2",
    "encoding-japanese": "^2.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "ffmpeg-wasm": "^1.0.1",
    "fontisto": "^3.0.4",
    "jschardet": "^4.0.0",
    "uglify-js": "^3.19.3",
    "vue": "^3.3.8",
    "vue-router": "^5.0.4",
    "vuetify": "^4.0.1",
    "wasm-loader": "^1.3.0"
  },
