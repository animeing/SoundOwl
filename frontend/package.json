    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.0.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "style-loader": "^4.0.0",
    "vue-loader": "^17.3.1",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^5.1.0",
    "webpack-cli": "^7.0.3",
    "ws": "^8.21.0"
  }
